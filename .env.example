# Copy this file to .env in the directory where you run pdf-redactor.
GEMINI_API_KEY=
# Paste the exact model ID available to your Gemini API key. Required; no default.
GEMINI_MODEL=
# Pace all Gemini calls/retries below your project's RPM allowance.
GEMINI_REQUESTS_PER_MINUTE=5
PDF_SERVICES_CLIENT_ID=
# Either an access token (temporary) OR a client secret (SDK-managed tokens).
PDF_SERVICES_ACCESS_TOKEN=
PDF_SERVICES_CLIENT_SECRET=
